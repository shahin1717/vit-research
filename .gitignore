# ==============================================================================
# Git Ignore Configuration: ViT Registers Research Project (aiac-res)
# ==============================================================================

# Python Bytecode & Cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.pytest_cache/
.ipynb_checkpoints/
.ruff_cache/
.obsidian/

# Conda / Virtual Environments
env/
venv/
.venv/
ENV/
.conda/
miniconda3/

# Model Checkpoints & Large Binaries (Strictly Ignored)
checkpoints/
checkpoints_databudget/
weights/
*.pt
*.pth
*.ckpt
*.bin
*.onnx
*.safetensors
*.engine

# Datasets & Cached Tensors
data/*
!data/.gitkeep
*.tar
*.tar.gz
*.tgz
*.zip
*.7z
*.h5
*.hdf5
*.npy
*.npz
*.parquet

# Temporary Training Runs & Profiler Dumps (outputs/ and outputs_databudget/ logs, metrics & JSONs are tracked)
runs/
tb_logs/
wandb/

# LaTeX Build Artifacts (the compiled .pdf deliverables are kept)
*.aux
*.bbl
*.blg
*.out
*.toc
*.lof
*.lot
*.nav
*.snm
*.vrb
*.fls
*.fdb_latexmk
*.synctex.gz

# IDE & Operating System Files
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/launch.json
!.vscode/tasks.json
*.swp
*.swo

# Environment & Secrets
.env
.env.*
!.env.example
*.conf
*.key

# Project Local Workspace Links & Agents
aiac-res.code-workspace
.agents/
.claude/
.gemini/
.system_generated/

